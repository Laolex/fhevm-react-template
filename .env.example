# Example environment variables for local development
# Copy to .env and fill values as needed

# Wallet mnemonic used by Hardhat/local deployment
MNEMONIC="test test test test test test test test test test test junk"

# Optional: Alchemy/Infura or other JSON-RPC provider if you test remote chains
#RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-key"

# Optional relayer URL for production relayer
#RELAYER_URL="https://relayer.example.com"

# Optional: If deploying to sepolia or other networks
#SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/your-key"
